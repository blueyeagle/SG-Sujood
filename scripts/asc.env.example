# App Store Connect API key config for scripts/upload-testflight.sh
# Copy this file to  scripts/asc.env  (which is gitignored) and fill in your values.
#
# Get these from App Store Connect → Users and Access → Integrations →
# App Store Connect API → Keys.  Give the key the "App Manager" role.
# Download the AuthKey_XXXXXXXXXX.p8 ONCE (it can't be downloaded again).

export ASC_KEY_ID="XXXXXXXXXX"
export ASC_ISSUER_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
export ASC_KEY_P8="$HOME/Downloads/AuthKey_XXXXXXXXXX.p8"
